# arm pick & place -- gen-z mode 💅
# same Robot Chalao, just the casual keywords. runs identically to example 01.
robot linkup "ur5"
pace 0.4

crib slide                                  # go home

bet pick = pose(0.4, 0.1, 0.2, 0, 3.14, 0)  # bet = let
slide pick                                   # slide = go to
grab                                         # grab = close gripper
seedha slide (0.4, 0.1, 0.4)                 # lift straight up

slide pose(0.4, -0.2, 0.2, 0, 3.14, 0)
dip                                          # dip = let go

crib slide
robot dip                                    # disconnect
