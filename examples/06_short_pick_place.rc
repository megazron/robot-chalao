# arm pick & place -- short mode
# same Robot Chalao, just the common keywords typed short.
# runs identically to example 01.
robot jodo "ur5"
speed 0.4

ghar jao
rakh pick = pose(0.4, 0.1, 0.2, 0, 3.14, 0)   # rakh = maano (variable)
jao pick
pakdo

agar battery kitni hai > 20 toh
    bol "battery theek hai, chalte hain"      # bol = dikhao (print)
warna
    bol "charge chahiye"
bas                                            # bas = khatam (end block)

jao pose(0.4, -0.2, 0.2, 0, 3.14, 0)
chhodo
ghar jao
robot chhodo
