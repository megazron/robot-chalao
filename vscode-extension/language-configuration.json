{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "(\\btoh\\b|\\bkaro\\b|\\bmein\\b|\\bkoshish\\b|\\bwarna\\b|\\bhone par\\b)\\s*$",
    "decreaseIndentPattern": "^\\s*(khatam|warna|galti hone par)\\b"
  }
}
